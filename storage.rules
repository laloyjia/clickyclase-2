rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function userLiceo() {
      return isSignedIn() && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.liceoSlug
        : '';
    }
    function hasRole(rol) {
      return isSignedIn() && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && (firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role == rol
            || (firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.roles != null
                && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.roles[rol] == true));
    }
    function esEquipoApoyo() { return hasRole('aps_enc') || hasRole('aps_prof'); }
    function esEquipoPIE()   { return hasRole('pie_coord') || hasRole('pie_edu'); }
    function esDirectivo()   { return hasRole('director') || hasRole('rector') || hasRole('admin_colegio'); }
    function isAdmin()       { return hasRole('admin') || hasRole('superadmin'); }

    // ── Adjuntos APS: coordinaciones red externa, familia, casos ──
    match /apoyo_adjuntos/{liceoSlug}/{allPaths=**} {
      allow read:  if isAdmin() || (userLiceo() == liceoSlug && (esEquipoApoyo() || esDirectivo()));
      allow write: if isAdmin() || (userLiceo() == liceoSlug && esEquipoApoyo() &&
                                    request.resource.size < 15 * 1024 * 1024); // 15 MB máx
    }

    // ── Adjuntos PIE: PACI, FUDEI, reevaluaciones ─────────────────
    match /pie_adjuntos/{liceoSlug}/{allPaths=**} {
      allow read:  if isAdmin() || (userLiceo() == liceoSlug && (esEquipoPIE() || esDirectivo()));
      allow write: if isAdmin() || (userLiceo() == liceoSlug && esEquipoPIE() &&
                                    request.resource.size < 20 * 1024 * 1024);
    }

    // ── Fallback: leer avatares y logos públicos ──────────────────
    match /publico/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
